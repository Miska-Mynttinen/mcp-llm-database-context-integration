# Rate limits and daily AI token budgets - copy to .env.limits and adjust:
#   cp .env.limits.example .env.limits
#
# Every setting is optional: a missing file or variable uses the default shown.
# Real environment variables override values from this file.
# Over-limit requests get HTTP 429 with a Retry-After header.

# Set to false to turn off every request limit below. Token budgets are separate:
# set each CHAT_TOKENS_DAILY_* to "off" to turn them off.
RATE_LIMIT_ENABLED=true

# ----------------------------------------------------------------------------
# Request limits: <count>/<window>, or "off" to disable just that limit.
# Window units: ms, s, m, h, d (for example 5/1h, 300/1m, 1000/1d).
# Counters are in memory: they reset when the app restarts.
# ----------------------------------------------------------------------------
# Sign-ups per client IP (failed attempts count too)
RATE_LIMIT_REGISTER_IP=5/1h
# Sign-ups across all clients together
RATE_LIMIT_REGISTER_GLOBAL=50/1h
# Failed logins per client IP (successful logins don't count)
RATE_LIMIT_LOGIN_FAILED_IP=10/15m
# Chat messages per user
RATE_LIMIT_CHAT_USER=20/1m
# Chat messages per client IP, across all accounts on that IP
RATE_LIMIT_CHAT_IP=40/1m
# Requests to any /api route per client IP
RATE_LIMIT_API_IP=300/1m

# ----------------------------------------------------------------------------
# Daily AI token budgets: LLM tokens (prompt + completion, as reported by the
# provider) per UTC day, or "off". They reset at 00:00 UTC and are stored in
# the database (table llm_token_usage), so restarts don't reset them.
# A chat turn is allowed while usage is under budget, so the last turn of the
# day can go over it.
# ----------------------------------------------------------------------------
# Per user
CHAT_TOKENS_DAILY_USER=100000
# Per client IP, across all accounts on that IP
CHAT_TOKENS_DAILY_IP=300000
# Across all users: a hard daily cost cap for the whole service
CHAT_TOKENS_DAILY_GLOBAL=off

# ----------------------------------------------------------------------------
# Client IP
# ----------------------------------------------------------------------------
# Number of reverse proxies in front of the app whose X-Forwarded-For header is
# trusted for the client IP. Keep 0 unless a proxy is really there: otherwise
# clients can spoof their IP and dodge the per-IP limits and budgets. Applies even
# with RATE_LIMIT_ENABLED=false, since logs and token budgets use the client IP too. Behind one proxy
# (nginx, Traefik, a cloud load balancer) set 1, or every client shares the
# proxy's IP and its limits.
TRUST_PROXY=0
