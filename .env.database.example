# Database configuration - copy to .env.database and fill in your values:
#   cp .env.database.example .env.database
# Read by both the chat app and the MCP server at startup.
# Real environment variables override these values.

# Database type: sqlite | postgres | mysql
DB_TYPE=sqlite

# For SQLite, DB_NAME is the database file path
DB_NAME=database.db

# Connection details for postgres/mysql (defaults: localhost, 5432 or 3306,
# user postgres or root). DB_PASSWORD has no default.
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=password
# DB_NAME=testdb

# TLS for postgres/mysql: off (default) | require (encrypted, certificate not
# checked) | verify (certificate checked; add a private CA with NODE_EXTRA_CA_CERTS).
# Managed databases (RDS, Azure, Supabase, ...) usually need require or verify.
# DB_SSL=off

# The database cancels a statement running longer than this (milliseconds), so
# a runaway LLM query frees its connection. 0 = no limit. Default 30000.
# PostgreSQL: every statement; MySQL: SELECTs only; SQLite: not supported.
# DB_STATEMENT_TIMEOUT_MS=30000

# Read-only login for untrusted SQL (postgres/mysql only). When set, the app
# (and `npm run seed`) creates or updates it at startup with SELECT on every
# table except the app's own, and no writes; the MCP server connects as it
# instead of DB_USER, so the database itself keeps LLM-written SQL away from
# the app tables. DB_USER must be allowed to create logins (e.g. the owner).
# The password may not contain quotes, backslashes or control characters.
# DB_READONLY_USER=mcp_reader
# DB_READONLY_PASSWORD=

# ----------------------------------------------------------------------------
# Examples
# ----------------------------------------------------------------------------
# PostgreSQL:
# DB_TYPE=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=password
# DB_NAME=testdb
#
# MySQL:
# DB_TYPE=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=mysql_password
# DB_NAME=mydb
