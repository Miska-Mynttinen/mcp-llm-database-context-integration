{
  "name": "mcp-llm-database-context-integration",
  "version": "1.0.0",
  "description": "A general platform for integrating Large Language Models of your choice to a MCP Client and MCP server integration to a database of your choice",
  "keywords": [
    "mcp",
    "llm",
    "database",
    "context"
  ],
  "license": "ISC",
  "author": "Miska Mynttinen",
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "test": "npm run build:backend && node --test tests/*.test.js",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "npm run build --workspaces && tsc -p .",
    "build:frontend": "npm --prefix frontend run build",
    "start": "node dist/index.js",
    "dev": "npm run build:backend && npm start",
    "frontend:dev": "cd frontend && npm run dev",
    "mcp-server:start": "node packages/mcp-server/dist/index.js",
    "seed": "node dist/src/seed/cli.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@mcp-llm/database": "1.0.0",
    "@mcp-llm/mcp-client": "1.0.0",
    "@mcp-llm/runtime": "1.0.0",
    "express": "^4.18.0",
    "express-rate-limit": "^8.7.0",
    "jsonwebtoken": "^9.0.3",
    "openai": "^4.77.0",
    "pino": "^10.3.1",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/express": "^4.17.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.70.1"
  },
  "private": true,
  "engines": {
    "node": ">=20.12"
  },
  "workspaces": [
    "packages/runtime",
    "packages/database",
    "packages/mcp-client",
    "packages/mcp-server"
  ]
}
