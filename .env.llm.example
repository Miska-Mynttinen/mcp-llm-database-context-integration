# LLM configuration - copy to .env.llm and fill in your values:
#   cp .env.llm.example .env.llm
# Read by the chat app at startup. Real environment variables override these values.

# Provider: openai | anthropic | ollama
LLM_PROVIDER=ollama

# Model identifier - depends on provider (defaults shown in brackets):
#   openai:    gpt-4o, gpt-4-turbo, gpt-3.5-turbo   [gpt-3.5-turbo]
#   anthropic: claude-opus-5, claude-sonnet-5, claude-haiku-4-5   [claude-opus-5]
#   ollama:    llama2, mistral, qwen2.5, ... (must be pulled locally)   [llama2]
LLM_MODEL=llama2

# API key - required for openai and anthropic, ignored for ollama
#   OpenAI:    https://platform.openai.com/account/api-keys
#   Anthropic: https://console.anthropic.com/
# LLM_API_KEY=your_api_key_here

# Base URL: the Ollama host, or an OpenAI/Anthropic-compatible endpoint.
# Ollama default: http://localhost:11434
# From inside Docker Compose use: http://host.docker.internal:11434
LLM_BASE_URL=http://localhost:11434

# Tool calling: "native" uses the provider's tool API, "text" describes tools in the
# prompt and parses JSON replies. Default: native for openai/anthropic, text for ollama.
# LLM_TOOL_CALLING=native

# Ollama only: context window in tokens (sent as num_ctx). Default 8192. Ollama's own
# default is often 4096, and it silently cuts longer prompts (system prompt, database
# schema, tool results). Larger values use more memory.
# LLM_CONTEXT_LENGTH=8192

# ----------------------------------------------------------------------------
# Examples
# ----------------------------------------------------------------------------
# OpenAI:
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o
# LLM_API_KEY=sk-...
#
# Anthropic:
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-opus-5
# LLM_API_KEY=sk-ant-...
