# MCP server access - copy to .env.mcp:
#   cp .env.mcp.example .env.mcp
#
# Read by both the chat app and the database MCP server (like .env.database).
# Real environment variables override values from this file.

# Shared secret the chat app sends as "Authorization: Bearer <token>" on every
# MCP request. The MCP server refuses to start without it and answers 401 to any
# request that doesn't carry it, so only the app (and so only logged-in users,
# through chat) can run its database tools. At least 32 characters.
# The value below is for local development only. Replace it anywhere else with:
#   openssl rand -hex 32
MCP_AUTH_TOKEN=dev-mcp-token-dev-mcp-token-dev-mcp-token

# Browser origins allowed to call the MCP server, comma-separated. Leave empty:
# the chat app calls it from the server side and sends no Origin, so any request
# from a web page is refused with 403.
MCP_ALLOWED_ORIGINS=

# ----------------------------------------------------------------------------
# MCP server only (the chat app ignores these)
# ----------------------------------------------------------------------------
# Host headers accepted on /mcp, comma-separated (DNS-rebinding protection).
# Add a hostname if you reach the server under another name.
# MCP_ALLOWED_HOSTS=localhost,127.0.0.1,[::1],mcp-server

# Close MCP sessions idle for this many milliseconds (default 30 minutes).
# MCP_SESSION_IDLE_TIMEOUT_MS=1800000
