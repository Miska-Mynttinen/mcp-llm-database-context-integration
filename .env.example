# MCP LLM Database Context Integration - Example Configuration
# Copy this file to .env and fill in your values

# ============================================================================
# LLM Provider Configuration
# ============================================================================
# Supported providers: openai, anthropic, ollama

# Provider to use
LLM_PROVIDER=ollama

# Model identifier - depends on provider:
#   OpenAI: gpt-3.5-turbo, gpt-4, gpt-4-turbo-preview
#   Anthropic: claude-3-opus-20240229, claude-3-sonnet-20240229, claude-3-haiku-20240307
#   Ollama: llama2, mistral, neural-chat, openchat, dolphin-mixtral (must be running locally)
LLM_MODEL=llama2

# API Key (required for OpenAI and Anthropic, ignored for Ollama)
# OpenAI: Get from https://platform.openai.com/account/api-keys
# Anthropic: Get from https://console.anthropic.com/
# LLM_API_KEY=your_api_key_here

# Base URL (only needed for self-hosted providers like Ollama)
# Ollama runs on http://localhost:11434 by default
LLM_BASE_URL=http://localhost:11434

# ============================================================================
# Database Configuration
# ============================================================================
# Supported types: sqlite, postgres, mysql

# Database type
DB_TYPE=sqlite

# For SQLite, the database name is the file path
DB_NAME=database.db

# Database connection details for non-SQLite databases
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=password
# DB_NAME=testdb

# Optional: Connection pool settings
# DB_POOL_MIN=2
# DB_POOL_MAX=10
# DB_POOL_IDLE_TIMEOUT=30000

# Optional: Query execution settings
# DB_QUERY_TIMEOUT=30000
# DB_MAX_RESULT_SIZE=10000

# ============================================================================
# MCP Server Configuration
# ============================================================================

# Comma-separated Streamable HTTP MCP server URLs.
# Each URL creates one client connection for this application instance.
MCP_SERVER_URLS=http://localhost:3001/mcp

# ============================================================================
# Example Configurations
# ============================================================================

# Using OpenAI GPT-4:
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4
# LLM_API_KEY=sk-...

# Using Anthropic Claude 3:
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-3-sonnet-20240229
# LLM_API_KEY=sk-ant-...

# Using Ollama locally (requires Ollama running):
# LLM_PROVIDER=ollama
# LLM_MODEL=llama2
# LLM_BASE_URL=http://localhost:11434
# (No API key needed)

# Using MySQL database:
# DB_TYPE=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=mysql_password
# DB_NAME=mydb
