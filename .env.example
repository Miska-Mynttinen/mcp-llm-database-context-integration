# App configuration - copy to .env and fill in your values:
#   cp .env.example .env
#
# LLM and database settings live in their own files:
#   .env.llm       (see .env.llm.example)
#   .env.database  (see .env.database.example)
#   .env.mcp       (see .env.mcp.example): MCP_AUTH_TOKEN, shared with the MCP server
#   .env.limits    (see .env.limits.example): rate limits and daily AI token budgets
# Real environment variables override values from any of these files.

# Chat server HTTP port
PORT=3000

# Comma-separated Streamable HTTP MCP server URLs.
# Each URL creates one client connection for this application instance.
# The LLM's database tools come only from MCP servers: run the bundled one with
# `npm run mcp-server:start`. Empty means the LLM has no database tools. When set,
# MCP_AUTH_TOKEN must be set too (in .env.mcp); the app refuses to start without it.
MCP_SERVER_URLS=http://localhost:3001/mcp

# Browser origins, besides the app's own, allowed to call the API
# (comma-separated, such as https://chat.example.com). Requests from any other
# origin get 403. Needed when a reverse proxy changes the Host header, so that
# the public origin no longer matches it.
ALLOWED_ORIGINS=

# Log level for the JSON logs on stdout: trace, debug, info, warn, error, fatal
LOG_LEVEL=info

# Serve Prometheus metrics at GET /metrics (set to false to disable). They are served
# on METRICS_PORT, not PORT, so a reverse proxy in front of the app never exposes them.
METRICS_ENABLED=true
METRICS_PORT=9464
# Loopback by default; Docker Compose sets 0.0.0.0 so Prometheus can reach it on the
# compose network (the port is not published to the host).
METRICS_HOST=127.0.0.1

# ----------------------------------------------------------------------------
# Authentication
# ----------------------------------------------------------------------------
# Secret used to sign login tokens (HS256). Required, at least 32 characters.
# The value below is for local development only: anyone who knows it can forge
# logins. Replace it anywhere else with: openssl rand -hex 32
JWT_SECRET=saltsecret-saltsecret-saltsecret-00

# How long a login token stays valid: e.g. 8h, 30m, 7d, or a number of seconds
JWT_EXPIRES_IN=8h

# Users seeded into the configured database (table app_users) at startup.
# Seeding only creates users that do not exist; it never changes an existing
# password. To change passwords, run: npm run seed -- --reset-password
# Anyone can also create an account from the login page.

# Docker Compose production override only (docker-compose.prod.yaml): password
# of the compose-managed PostgreSQL. Required there; generate it with
# openssl rand -hex 32. Local docker-compose.yaml uses "password".
# POSTGRES_PASSWORD=

# Docker Compose: password of mcp_reader, the read-only database login the MCP
# server connects as. Local docker-compose.yaml defaults to "readonly-password";
# the production override requires it (openssl rand -hex 32).
# DB_READONLY_PASSWORD=

# Shared password for the users user1, user2, user3, user4 and user5.
# At least 8 characters. Leave empty to seed no users.
# Development default; change it anywhere the app is reachable by others.
SEED_USER_PASSWORD=password

# ----------------------------------------------------------------------------
# Docker Compose only (substituted into docker-compose*.yaml; the app ignores them)
# ----------------------------------------------------------------------------
# Production override: where the app port is published for the reverse proxy.
# APP_BIND=127.0.0.1
# APP_PORT=3000

# Monitoring profile: Grafana login. Set a real password for any shared host.
# GRAFANA_ADMIN_USER=admin
# GRAFANA_ADMIN_PASSWORD=

# Monitoring profile: container runtime socket read by Alloy for logs.
# For rootless Podman: $XDG_RUNTIME_DIR/podman/podman.sock
# DOCKER_SOCK=/var/run/docker.sock
